#!/usr/bin/env python3
"""Install and use a GitHub branch and label workflow."""
import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONFIG = ".github/sdlc.json"


def run(*cmd):
    return subprocess.check_output(cmd, text=True).strip()


def repository():
    url = run("git", "config", "--get", "remote.origin.url")
    match = re.fullmatch(r"(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)([\w.-]+/[\w.-]+?)(?:\.git)?/?", url)
    if not match:
        raise ValueError("Expected a github.com origin.")
    return match[1]


def clean():
    if run("git", "status", "--porcelain"):
        raise ValueError("Commit or stash local changes before starting a branch.")


def preflight(repo):
    if not shutil.which("gh"):
        raise ValueError("Install GitHub CLI (gh) before running init.")
    try:
        login = run("gh", "api", "--hostname", "github.com", "user", "--jq", ".login")
    except subprocess.CalledProcessError as error:
        raise ValueError("Cannot identify the active github.com account. Check gh auth status.") from error
    print(f"GitHub account: {login} | Repository: {repo}", flush=True)
    try:
        role = run("gh", "repo", "view", f"github.com/{repo}", "--json", "viewerPermission",
                   "--jq", ".viewerPermission")
        existing = run("gh", "api", "--hostname", "github.com", "--paginate",
                       f"repos/{repo}/labels", "--jq", '.[] | [.name,.color] | @tsv' )
    except subprocess.CalledProcessError as error:
        raise ValueError(f"Cannot read repository metadata or labels for {repo}. Check token access.") from error
    print(f"Repository role: {role} | Label listing succeeded.")
    return role, dict(line.split("\t", 1) for line in existing.splitlines())


def read_profile(path):
    profile = json.loads(path.read_text())
    names = [*profile["work"].values(), *profile["release"].values(),
             *("version:" + v for v in profile["versions"])]
    if "labels" in profile and "label_colors" in profile:
        raise ValueError("Use labels or legacy label_colors, not both.")
    palette = profile.get("labels", profile.get("label_colors"))
    if palette is None:
        # Profiles generated before colors were introduced.
        defaults = json.loads((HERE / "profile.json").read_text())["labels"]
        palette = {name: defaults.get(name, "808080") for name in names}
    profile["labels"] = palette
    if not isinstance(palette, dict) or not set(names) <= set(palette):
        raise ValueError("labels must define every work, release and version label; extra labels are allowed.")
    if any(not isinstance(color, str) or (color and not re.fullmatch(r"[0-9a-fA-F]{6}", color))
           for color in palette.values()):
        raise ValueError("Use six hexadecimal digits without # for each label color.")
    return profile


def label_plan(existing, profile):
    palette = profile["labels"]
    current = {name.casefold(): (name, color.upper()) for name, color in existing.items()}
    changes = []
    for name, color in palette.items():
        key = name.casefold()
        color = color.upper()
        if key not in current:
            changes.append(("create", name, color or "808080"))
        elif color and current[key][1] != color:
            changes.append(("edit", current[key][0], color))
    return changes


def sync_labels(repo, changes, preview):
    for action, name, color in changes:
        print(f"Label {action}: {name} #{color}", flush=True)
        if not preview:
            run("gh", "label", action, name, "--repo", f"github.com/{repo}", "--color", color)
    if not changes:
        print("Label colors are up to date.")


def workflow_references(path, profile):
    workflows = json.loads(path.read_text())
    if not isinstance(workflows, dict):
        raise ValueError("Expected a workflow name to labels mapping.")
    for workflow, refs in workflows.items():
        if not isinstance(refs, list) or not all(isinstance(ref, str) for ref in refs):
            raise ValueError(f"{workflow}: expected a list of label names.")
        missing = sorted(set(refs) - profile["labels"].keys())
        if missing:
            raise ValueError(f"{workflow}: undefined profile labels: {', '.join(missing)}")
    return workflows


def init(args):
    repo = repository()
    root = Path(run("git", "rev-parse", "--show-toplevel"))
    source = args.profile or (root / CONFIG if (root / CONFIG).exists() else HERE / "profile.json")
    profile = read_profile(source)
    files = {CONFIG: source.read_text()}
    workflow_source = args.workflow_labels
    if workflow_source is None:
        adjacent = source.with_name("workflow-labels.json")
        if adjacent.is_file():
            workflow_source = adjacent
    if workflow_source is not None:
        workflow_references(workflow_source, profile)
        files[".github/workflow-labels.json"] = workflow_source.read_text()
    print(f"Profile: {source}")
    dev, main = profile["integration"], profile["production"]
    for source, target in [("policy.yml", ".github/workflows/sdlc-policy.yml"),
                           ("policy.py", ".github/scripts/sdlc_policy.py"),
                           ("pull_request_template.md", ".github/pull_request_template.md")]:
        files[target] = (HERE / "templates" / source).read_text()
    files["CONTRIBUTING.md"] = (f"Start a feature, bug or remediation branch from {dev}. Open a PR into {dev} "
                                f"with the matching work label, {profile['release']['integration']} and one version label. "
                                f"Release through a PR from {dev} into {main} with {profile['release']['production']}.\n")
    role, existing = preflight(repo)
    remote = run("git", "ls-remote", "--heads", "origin", "refs/heads/" + dev, "refs/heads/" + main)
    refs = {ref: sha for sha, ref in (line.split() for line in remote.splitlines())}
    devref = "refs/heads/" + dev
    base = refs.get(devref) or refs["refs/heads/" + main]
    changes = label_plan(existing, profile)
    print(f"Integration branch: {dev} ({'exists' if devref in refs else 'create'})")
    if args.dry_run:
        sync_labels(repo, changes, True)
    run("git", "fetch", "--quiet", "origin", base)
    missing = []
    for path, content in files.items():
        if subprocess.run(["git", "cat-file", "-e", base + ":" + path], stderr=subprocess.DEVNULL).returncode:
            missing.append(path)
        elif run("git", "show", base + ":" + path) != content.strip():
            raise ValueError(f"Existing file differs: {path}. Review it before installation.")
    print("Files to add:", ", ".join(missing) or "none")
    if args.dry_run:
        return
    if role not in {"WRITE", "MAINTAIN", "ADMIN"}:
        raise ValueError(f"Applying init requires write access to {repo}; current role: {role}.")
    clean()
    if devref not in refs:
        run("git", "push", "origin", base + ":" + devref)
        print(f"Created remote branch {dev}.", flush=True)
    sync_labels(repo, changes, False)
    if missing:
        run("git", "switch", "-c", next(iter(profile["work"])) + "/sdlc-bootstrap", base)
        for path in missing:
            destination = root / path
            destination.parent.mkdir(parents=True, exist_ok=True)
            with destination.open("x") as stream:
                stream.write(files[path])
        print("Review and commit the generated files, then run sdlc pr --version patch.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    install = sub.add_parser("init")
    install.add_argument("--profile", type=Path, help="Use a customized JSON profile for bootstrap")
    install.add_argument("--workflow-labels", type=Path, help="Workflow-to-label reference JSON")
    install.add_argument("--dry-run", action="store_true")
    labels = sub.add_parser("labels")
    labels.add_argument("--profile", type=Path, help="Override the installed repository profile")
    labels.add_argument("--dry-run", action="store_true")
    check = sub.add_parser("check-workflow-labels", help="Check declared labels locally and on GitHub")
    check.add_argument("--profile", type=Path)
    check.add_argument("--workflow-labels", type=Path)
    rules = sub.add_parser("ruleset", help="Print an importable branch ruleset JSON")
    rules.add_argument("branch", choices=["dev", "main"])
    pom = sub.add_parser("check-pom-version")
    pom.add_argument("before")
    pom.add_argument("after")
    start = sub.add_parser("start")
    start.add_argument("kind")
    start.add_argument("title")
    start.add_argument("--issue", type=int)
    start.add_argument("--push", action="store_true")
    pr = sub.add_parser("pr")
    pr.add_argument("--version", required=True)
    args = parser.parse_args()
    if args.action == "check-pom-version":
        from pom_version import verify
        verify(args.before, args.after)
        return
    if args.action == "ruleset":
        from ruleset import branch_ruleset
        print(json.dumps(branch_ruleset(args.branch), indent=2))
        return
    if args.action == "check-workflow-labels":
        root = Path(run("git", "rev-parse", "--show-toplevel"))
        source = args.profile or root / CONFIG
        path = args.workflow_labels or source.with_name("workflow-labels.json")
        workflows = workflow_references(path, read_profile(source))
        _, existing = preflight(repository())
        present = {name.casefold() for name in existing}
        missing = {label for refs in workflows.values() for label in refs if label.casefold() not in present}
        if missing:
            raise ValueError("Missing GitHub labels: " + ", ".join(sorted(missing)) + ". Run sdlc labels.")
        print(f"Verified label references for {len(workflows)} workflow(s).")
        return
    if args.action == "labels":
        repo = repository()
        _, existing = preflight(repo)
        installed = Path(run("git", "rev-parse", "--show-toplevel")) / CONFIG
        source = args.profile or (installed if installed.exists() else HERE / "profile.json")
        print(f"Profile: {source}")
        sync_labels(repo, label_plan(existing, read_profile(source)), args.dry_run)
        return
    if args.action == "init":
        return init(args)
    root = Path(run("git", "rev-parse", "--show-toplevel"))
    profile = json.loads((root / CONFIG).read_text())
    repo = repository()
    dev = profile["integration"]
    if args.action == "start":
        slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")
        if not slug or args.kind not in profile["work"] or (args.issue is not None and args.issue < 1):
            parser.error("Provide a valid work type, title and positive issue number.")
        clean()
        if args.issue:
            run("gh", "issue", "view", str(args.issue), "--repo", repo, "--json", "number")
        branch = f"{args.kind}/" + (f"{args.issue}-" if args.issue else "") + slug
        run("git", "fetch", "origin", dev)
        run("git", "switch", "-c", branch, "FETCH_HEAD")
        if args.issue:
            run("gh", "issue", "edit", str(args.issue), "--repo", repo, "--add-label", profile["work"][args.kind])
        if args.push:
            run("git", "push", "-u", "origin", branch)
        print(branch)
    else:
        clean()
        head = run("git", "branch", "--show-current")
        kind = head.split("/")[0]
        if "/" not in head or kind not in profile["work"] or args.version not in profile["versions"]:
            parser.error("Use a configured work branch and version.")
        run("git", "push", "-u", "origin", head)
        print(run("gh", "pr", "create", "--repo", repo, "--base", dev, "--head", head, "--fill",
                  "--label", profile["work"][kind], "--label", profile["release"]["integration"],
                  "--label", "version:" + args.version))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
